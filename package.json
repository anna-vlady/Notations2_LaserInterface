{
  "name": "laser-audio-touch-interface",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "reset-ports": "lsof -ti :3000-3015 -ti :4000 -ti :9000 | xargs kill -9 2>/dev/null || true",
    "start": "npm run reset-ports && concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.26.0",
    "node-osc": "^11.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "vite": "^5.4.11"
  }
}
